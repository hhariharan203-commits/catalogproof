PORT=3000
DATABASE_PATH=./data/catalogproof.sqlite
PUBLIC_BASE_URL=https://your-demo-host.example
DEMO_PASSWORD=replace-with-long-random-value
SESSION_SECRET=replace-with-at-least-32-random-characters
NODE_ENV=development

# NVIDIA hosted NIM (OpenAI-compatible Chat Completions). Leave the key blank to fail closed.
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_API_KEY=
# Live app smoke verified with the NVIDIA settings below; use your own API-testing key.
AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
AI_REQUEST_TIMEOUT_MS=90000
AI_NVIDIA_ENABLE_THINKING=false

# PayPal Sandbox only. Never use live credentials or the live API base.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
